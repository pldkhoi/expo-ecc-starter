{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(bun run:*)",
      "Bash(bun pm ls)",
      "Bash(bun expo:*)",
      "Bash(bunx:*)",
      "Bash(npx expo:*)",
      "Bash(npx expo install:*)",
      "Bash(npx expo prebuild:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npx create-expo-app:*)",
      "Bash(npx eas-cli:*)",
      "Bash(eas:*)",
      "Bash(npx detox:*)",
      "Bash(maestro:*)",
      "Bash(npx agentshield:*)",
      "Bash(npx ecc-agentshield:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git reset HEAD:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",
      "Bash(gh issue:*)",
      "Bash(gh api:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | sh)",
      "Bash(wget:* | sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/expo-public-env-guard.mjs",
            "timeout": 5
          }
        ],
        "description": "Block writes that put a secret-like value into an EXPO_PUBLIC_* env var (Expo bundles those into the JS bundle shipped with every install).",
        "id": "pre:edit-write:expo-public-env-guard"
      }
    ]
  }
}
