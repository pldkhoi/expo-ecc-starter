# Copy this file to .env.local. Expo bundles EXPO_PUBLIC_* into the JS bundle.
# NEVER assign secrets to EXPO_PUBLIC_* — the hook
# .claude/hooks/scripts/expo-public-env-guard.mjs blocks Write/Edit operations
# that try to.

# === Public (safe to ship to the JS bundle) ===
EXPO_PUBLIC_APP_NAME=expo-ecc-starter
EXPO_PUBLIC_API_URL=https://api.example.com

# === Server-only / EAS secrets (no prefix, never bundled) ===
# SENTRY_AUTH_TOKEN=
# EAS_BUILD_PROFILE=development
